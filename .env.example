# Copy this file to .env (which is gitignored) and fill in the values.
#   cp .env.example .env
# docker compose reads .env automatically and refuses to start if a value is missing.

# HMAC key used to sign JWTs. At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Password for the Postgres superuser and the API's connection string.
# It only takes effect when the database volume is first created; an existing
# volume keeps the password it was created with.
POSTGRES_PASSWORD=
