# Copy this file to .env (which is gitignored) and fill in the values.
#   cp .env.example .env
# docker compose reads .env automatically and refuses to start if a value is missing.

# HMAC key used to sign JWTs. At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Password for the Postgres superuser. Only compose's setup service and database tools use this login.
# It only takes effect when the database volume is first created; an existing
# volume keeps the password it was created with.
POSTGRES_PASSWORD=

# Password for grocerease_app, the role the API connects as. It is not a superuser.
# Compose creates the role and sets this password on every `docker compose up`, so
# changing it here takes effect on the next start. It goes into a connection string,
# so use only letters and digits:
#   openssl rand -hex 24
APP_DB_PASSWORD=
