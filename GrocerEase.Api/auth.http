@baseUrl = http://localhost:5000

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john2@example.com",
  "password": "Password123!"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john2@example.com",
  "password": "Password123!"
}

### Profile
GET {{baseUrl}}/profile
Authorization: Bearer {{login.response.body.$.token}}

### Refresh (replaces the refresh token, so run Login again before repeating it)
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Profile with the refreshed access token
GET {{baseUrl}}/profile
Authorization: Bearer {{refresh.response.body.$.token}}

### Logout (ends the session of the newest refresh token)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh.response.body.$.refreshToken}}"
}
