{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "GrocerEase",
    "Audience": "GrocerEase",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "PasswordHashing": {
    "Cost": 11
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
